# Odoo core (its own git repo already, ~2GB stock source - not tracked here)
/auditreelive-server/

# Python virtualenv
/venv/
**/__pycache__/
*.pyc
*.pyo

# Backups, dumps, archives
*.tar.gz
*.dump
/CAuditreeBackup/
/C:AuditreeBackup/

# Logs
*.log

# Local configs containing real secrets - use the .example templates instead
/odoo.conf
/auditreelive-server.conf

# GCP deployment scripts/secrets generated during provisioning
/deploy/

# Editor/OS cruft
.DS_Store
Thumbs.db

# Local dev config holding real credentials (db_password, admin_passwd).
# Previously NOT ignored - a broad git add would have published it.
/local-dev.conf

# Runtime artifacts
/odoo-local.pid

# Claude Code local overrides (settings.json is shared, .local.json is not)
/.claude/settings.local.json

# Editor settings
/.vscode/

# Stray capture file (an accidental less-help dump)
/tick
