<odoo>
	<data>
		



		
		<record id="inherit_account_move_form" model="ir.ui.view">
			<field name="name">Account Move</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_move_form" />
			<field name="arch" type="xml">
                <field name="invoice_date" position="after">
                    <field name="task_id"/>
                </field>

				<xpath expr="//form/sheet/notebook/page[@name='invoice_tab']/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
					<field name="task_line_id" column_invisible="0"/>
				</xpath>



			</field>
		</record>
	</data>
</odoo>
        
        