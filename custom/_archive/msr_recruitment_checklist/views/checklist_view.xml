<odoo>
    <record id="recr_check_list_form_view" model="ir.ui.view">
        <field name="name">recruitment.checklist.form.view</field>
        <field name="model">recruitment.checklist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_recruitment_checklist">
        <field name="name">Recruitment Checklist</field>
        <field name="res_model">recruitment.checklist</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="checklist_crm" name="Recruitment Checklist"
              parent="hr_recruitment.menu_hr_recruitment_config_employees"
              action="action_recruitment_checklist"/>
</odoo>