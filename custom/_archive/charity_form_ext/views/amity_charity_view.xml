<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_tree_charity_forms" model="ir.ui.view">
        <field name="name">amity.charity.tree</field>
        <field name="model">amity.charity</field>
        <field name="arch" type="xml">
            <tree string="Applications">
                <field name="name"/>
                <field name="applicant_name"/>
                <field name="date"/>
                <field name="age"/>
                <field name="application_type"/>
            </tree>
        </field>
    </record>

    <record id="view_form_charity_application" model="ir.ui.view">
        <field name="name">amity.charity.form</field>
        <field name="model">amity.charity</field>
        <field name="arch" type="xml">
            <form string="Application Register">

                <sheet>
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state =='confirm'"/>
                        <button name="action_create_payment" string="Create Payment" type="object" class="oe_highlight" invisible="state!='confirm' or payment_id!=False"/>

                        <field name="state" widget="statusbar"/>
                    </header>
                    <div class="oe_title">
                        <h2>
                            <field name="name" readonly="1" force_save="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="applicant_name"/>
                            <field name="date"/>
                            <field name="sl_no"/>
                            <field name="age"/>
                            <field name="application_type"/>
                            <field name="partner_id"/>
                            <field name="charity_amount"/>
                            <field name="journal_id"/>
                            <field name="payment_method_id" domain="[('journal_id','=',journal_id)]"/>
                            <field name="payment_date"/>
                            <field name="communication"/>
                        </group>
                        <group>
                            <field name="house_ame"/>
                            <field name="place"/>
                            <field name="district"/>
                            <field name="zip"/>
                            <field name="mobile"/>
                            <field name="phone"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="payment_id" readonly="1" force_save="1"/>
                        </group>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_charity_form" model="ir.actions.act_window">
        <field name="name">Application</field>
        <field name="res_model">amity.charity</field>
        <field name="view_id" ref="charity_form_ext.view_tree_charity_forms"/>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Applications
            </p>
        </field>
    </record>

</odoo>