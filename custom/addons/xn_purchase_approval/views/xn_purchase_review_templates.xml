<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="review_frame" name="Purchase Review Frame">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="body_classname" t-value="'bg-100'"/>
            <div class="container py-4" style="max-width: 760px;">
                <div class="text-center mb-4">
                    <img src="/web/binary/company_logo" alt="Logo" style="max-height: 60px;"/>
                </div>
                <div class="card">
                    <div class="card-body">
                        <t t-out="0"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="review_page" name="Purchase Review">
        <t t-call="xn_purchase_approval.review_frame">
            <t t-set="title" t-value="order.name"/>
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h3 class="mb-0">
                    <t t-out="order.name"/>
                    <small class="text-muted" t-out="order.partner_id.commercial_partner_id.name"/>
                </h3>
                <span t-if="order.state == 'to approve'" class="badge text-bg-warning">Waiting for approval</span>
                <span t-elif="order.state in ('purchase', 'done')" class="badge text-bg-success">Approved</span>
                <span t-else="" class="badge text-bg-secondary" t-out="dict(order._fields['state'].selection).get(order.state)"/>
            </div>

            <div t-if="error" class="alert alert-danger" t-out="error"/>
            <div t-if="order.state in ('purchase', 'done')" class="alert alert-success">
                Approved<t t-if="order.date_approve"> on <t t-out="order.date_approve" t-options="{'widget': 'datetime'}"/></t>.
                Accounts can now post the vendor bill and make the payment.
            </div>

            <table class="table table-sm mb-4">
                <tr>
                    <th class="text-muted fw-normal" style="width: 35%;">Requested by</th>
                    <td t-out="order.xn_requested_by_id.name or ''"/>
                </tr>
                <tr t-if="order.xn_employee_id">
                    <th class="text-muted fw-normal">For employee</th>
                    <td t-out="order.xn_employee_id.name"/>
                </tr>
                <tr t-if="order.partner_ref">
                    <th class="text-muted fw-normal">Vendor reference</th>
                    <td t-out="order.partner_ref"/>
                </tr>
                <tr>
                    <th class="text-muted fw-normal">Payment to</th>
                    <td>
                        <t t-if="order.xn_paid_by_card">Company card</t>
                        <t t-elif="order.xn_vendor_bank_id">
                            <t t-out="order.xn_vendor_bank_id.acc_holder_name or order.xn_vendor_bank_id.partner_id.name"/><br/>
                            <t t-out="order.xn_vendor_bank_id.bank_id.name or ''"/>
                            <t t-if="order.xn_vendor_bank_id.bank_id.bic"> (<t t-out="order.xn_vendor_bank_id.bank_id.bic"/>)</t><br/>
                            A/c <t t-out="order.xn_vendor_bank_id.acc_number"/>
                            <span t-if="order.xn_vendor_bank_id.allow_out_payment" class="badge text-bg-success ms-1">Verified</span>
                            <span t-else="" class="badge text-bg-danger ms-1">Not verified</span>
                        </t>
                        <span t-else="" class="text-danger">No bank account</span>
                    </td>
                </tr>
            </table>

            <table class="table table-sm mb-2">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Unit price</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="lines" t-as="line">
                        <td>
                            <t t-out="line.name"/>
                            <div t-if="line.xn_period_start and line.xn_period_end" class="small text-muted">
                                <t t-out="line.xn_period_start" t-options="{'widget': 'date'}"/> to
                                <t t-out="line.xn_period_end" t-options="{'widget': 'date'}"/>
                                (<t t-out="line.xn_period_days"/> days, pro-rata)
                            </div>
                        </td>
                        <td class="text-end" t-out="line.product_qty"/>
                        <td class="text-end" t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                        <td class="text-end" t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end text-muted">Untaxed</td>
                        <td class="text-end" t-out="order.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end text-muted">Taxes</td>
                        <td class="text-end" t-out="order.amount_tax" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                    </tr>
                    <tr>
                        <th colspan="3" class="text-end">Total</th>
                        <th class="text-end" t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                    </tr>
                </tfoot>
            </table>

            <div t-if="order.notes" class="mb-4">
                <h6 class="text-muted">Notes</h6>
                <div t-out="order.notes"/>
            </div>

            <div class="mb-4">
                <h6 class="text-muted">Attachments</h6>
                <ul t-if="attachments" class="list-unstyled mb-0">
                    <li t-foreach="attachments" t-as="att">
                        <i class="fa fa-paperclip me-1"/>
                        <a t-attf-href="/xn_purchase/review/#{order.id}/attachment/#{att.id}?token=#{token}"
                           target="_blank" t-out="att.name"/>
                    </li>
                </ul>
                <p t-else="" class="text-muted mb-0">None. Ask the requester for the vendor's PI before approving.</p>
            </div>

            <t t-if="order.state == 'to approve'">
                <form t-attf-action="/xn_purchase/review/#{order.id}/approve" method="post" class="mb-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="token" t-att-value="token"/>
                    <button type="submit" class="btn btn-success btn-lg w-100">Approve</button>
                </form>
                <details>
                    <summary class="text-danger mb-2" style="cursor: pointer;">Reject</summary>
                    <form t-attf-action="/xn_purchase/review/#{order.id}/reject" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="token" t-att-value="token"/>
                        <textarea name="reason" class="form-control mb-2" rows="3" required="required"
                                  placeholder="Why is this rejected? The requester will see this."/>
                        <button type="submit" class="btn btn-outline-danger w-100">Reject and send back</button>
                    </form>
                </details>
            </t>
        </t>
    </template>

    <template id="review_done" name="Purchase Review Done">
        <t t-call="xn_purchase_approval.review_frame">
            <t t-set="title" t-value="order.name"/>
            <p class="mb-0" t-out="message"/>
        </t>
    </template>
</odoo>
