<odoo>
    <record id="users_view" model="ir.ui.view">
        <field name="name">view.users.act</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <group name="messaging" position="after">
                    <group name="User Type" string="Freelancer">
                        <field name="is_freelancer"/>
                    </group>
                </group>

        </field>
    </record>

</odoo>