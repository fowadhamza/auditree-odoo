<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="name">product.template.form (in hr_personal_equipment_request)
        </field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purchase_ok']/.." position="after">
                <div>
                    <field name="is_asset"/>
                    <label for="is_asset"/>
                </div>
            </xpath>
               <div name="button_box" position="inside">
                    <button class="oe_stat_button" name="action_view_asset_requests"
                            icon="fa-tasks" type="object">
                        <field string="Asset Requests" name="asset_req_count" widget="statinfo"/>
                    </button>
                </div>
        </field>
    </record>




    <record id="asset_template_action_all" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_is_asset':True}</field>
        <field name="domain">[('is_asset','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product
            </p>
        </field>
    </record>

</odoo>
