<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecast_employee_list" model="ir.ui.view">
        <field name="name">forecast.employee.list</field>
        <field name="model">forecast.employee</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="auditree_title"/>
                <field name="client_role"/>
                <field name="employee_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="salary_plan_count" string="Salary Cycles" optional="show"/>
                <field name="current_monthly_cost" string="Monthly Cost" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_forecast_employee_form" model="ir.ui.view">
        <field name="name">forecast.employee.form</field>
        <field name="model">forecast.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_salary_plans" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="salary_plan_count" widget="statinfo" string="Salary Cycles"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="auditree_title"/>
                            <field name="client_role"/>
                            <field name="employee_type"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Salary Cycles" name="salary_cycles">
                            <p class="text-muted">
                                One cycle per salary period. Fixed and Variable CTC are annual
                                totals; the forecast charges (Fixed + Variable) / 12 for every
                                month in the cycle's From-To range. Cycles must not overlap -
                                leave 'To' empty on the current cycle and it is closed
                                automatically when you add the next one.
                            </p>
                            <field name="salary_plan_ids" context="{'default_employee_id': id}">
                                <tree editable="bottom" default_order="effective_date">
                                    <control>
                                        <create string="Add a salary cycle"/>
                                    </control>
                                    <field name="effective_date"/>
                                    <field name="end_date"/>
                                    <field name="fixed_ctc" sum="Total"/>
                                    <field name="variable_ctc" sum="Total"/>
                                    <field name="total_ctc" sum="Total"/>
                                    <field name="monthly_cost" sum="Total"/>
                                    <field name="hike_pct" optional="show"/>
                                    <field name="next_review_date" optional="show"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="current_period"/>
                                <field name="current_total_ctc"/>
                                <field name="current_monthly_cost"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_forecast_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">forecast.employee</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
