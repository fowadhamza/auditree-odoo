<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecast_monthly_line_list" model="ir.ui.view">
        <field name="name">forecast.monthly.line.list</field>
        <field name="model">forecast.monthly.line</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="month"/>
                <field name="line_type"/>
                <field name="direction"/>
                <field name="category"/>
                <field name="employee_id"/>
                <field name="client_id"/>
                <field name="amount"/>
            </tree>
        </field>
    </record>

    <record id="view_forecast_monthly_line_pivot" model="ir.ui.view">
        <field name="name">forecast.monthly.line.pivot</field>
        <field name="model">forecast.monthly.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="month" type="col"/>
                <field name="line_type" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_forecast_monthly_line_graph" model="ir.ui.view">
        <field name="name">forecast.monthly.line.graph</field>
        <field name="model">forecast.monthly.line</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="month"/>
                <field name="line_type"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_forecast_monthly_line" model="ir.actions.act_window">
        <field name="name">P&amp;L (Monthly Lines)</field>
        <field name="res_model">forecast.monthly.line</field>
        <field name="view_mode">pivot,tree,graph</field>
        <field name="help" type="html">
            <p class="o_view_nobutton">
                Generated data. Run "Recalculate" from Forecast &gt; Settings after
                changing revenue, salary, expense, or cash movement records.
            </p>
        </field>
    </record>
</odoo>
