<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecast_client_list" model="ir.ui.view">
        <field name="name">forecast.client.list</field>
        <field name="model">forecast.client</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="category"/>
                <field name="account_owner"/>
            </tree>
        </field>
    </record>

    <record id="view_forecast_client_form" model="ir.ui.view">
        <field name="name">forecast.client.form</field>
        <field name="model">forecast.client</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="account_owner"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_forecast_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">forecast.client</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
