<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecast_cash_movement_list" model="ir.ui.view">
        <field name="name">forecast.cash.movement.list</field>
        <field name="model">forecast.cash.movement</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="movement_type"/>
                <field name="amount"/>
                <field name="category"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="view_forecast_cash_movement_form" model="ir.ui.view">
        <field name="name">forecast.cash.movement.form</field>
        <field name="model">forecast.cash.movement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="movement_type"/>
                        <field name="amount"/>
                        <field name="category"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_forecast_cash_movement" model="ir.actions.act_window">
        <field name="name">Other Cash Movements</field>
        <field name="res_model">forecast.cash.movement</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nobutton">
                Use this for the initial opening cash balance (dated before the
                forecast window start), partner loan repayments, and any other
                ad-hoc cash items.
            </p>
        </field>
    </record>
</odoo>
