<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Installed active: it does nothing while AI is switched off
        (Settings > AI), and only looks at files attached in the last two
        days, so installing it does not send old CVs anywhere.
    -->
    <data noupdate="1">
        <record id="ir_cron_read_new_cvs" model="ir.cron">
            <field name="name">Recruitment: read new CVs</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="state">code</field>
            <field name="code">model._xn_cron_read_new_cvs()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
