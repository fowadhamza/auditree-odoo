<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_xn_jl" model="ir.ui.view">
        <field name="name">hr.employee.form.xn.jl</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_xn_jl_start_join" type="object" string="Start Joining Checklist"
                        groups="hr.group_hr_user"/>
                <button name="action_xn_jl_start_leave" type="object" string="Start Exit Checklist"
                        groups="hr.group_hr_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_xn_jl_view_checklists" type="object" class="oe_stat_button"
                        icon="fa-check-square-o" groups="hr.group_hr_user"
                        invisible="not xn_jl_checklist_count">
                    <field name="xn_jl_checklist_count" widget="statinfo" string="Checklists"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
