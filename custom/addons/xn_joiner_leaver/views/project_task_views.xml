<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_xn_jl" model="ir.ui.view">
        <field name="name">project.task.form.xn.jl</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="xn_jl" string="Checklist" invisible="not xn_jl_checklist_id">
                    <group>
                        <group>
                            <field name="xn_jl_checklist_id" readonly="1"/>
                            <field name="xn_jl_employee_id"/>
                            <field name="xn_jl_step_id" readonly="1"/>
                            <field name="xn_jl_due_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="xn_jl_proof_required" invisible="not xn_jl_proof_required"/>
                            <field name="xn_jl_has_proof" invisible="not xn_jl_proof_required"/>
                            <field name="xn_jl_external" readonly="1"/>
                            <field name="xn_jl_escalated" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_task_tree_xn_jl" model="ir.ui.view">
        <field name="name">project.task.tree.xn.jl</field>
        <field name="model">project.task</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree create="false" default_order="xn_jl_due_date, id"
                  decoration-muted="state in ['1_done', '1_canceled']"
                  decoration-danger="state not in ['1_done', '1_canceled'] and xn_jl_due_date and xn_jl_due_date &lt; current_date">
                <field name="xn_jl_due_date"/>
                <field name="name"/>
                <field name="xn_jl_employee_id" optional="show"/>
                <field name="xn_jl_process" optional="show"/>
                <field name="user_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="stage_id" optional="hide"/>
                <field name="xn_jl_has_proof" string="Proof" optional="show"/>
                <field name="xn_jl_escalated" optional="show"/>
                <field name="state" widget="project_task_state_selection" nolabel="1"/>
            </tree>
        </field>
    </record>

    <record id="view_task_search_xn_jl" model="ir.ui.view">
        <field name="name">project.task.search.xn.jl</field>
        <field name="model">project.task</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="xn_jl_employee_id"/>
                <field name="user_ids"/>
                <filter name="mine" string="My Steps" domain="[('user_ids', 'in', uid)]"/>
                <filter name="open" string="Open" domain="[('state', 'not in', ['1_done', '1_canceled'])]"/>
                <filter name="late" string="Late"
                        domain="[('state', 'not in', ['1_done', '1_canceled']), ('xn_jl_due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="escalated" string="Escalated"
                        domain="[('state', 'not in', ['1_done', '1_canceled']), ('xn_jl_escalated', '=', True)]"/>
                <filter name="waiting" string="Not Dated Yet" domain="[('xn_jl_due_date', '=', False)]"/>
                <separator/>
                <filter name="join" string="Joining" domain="[('xn_jl_process', '=', 'join')]"/>
                <filter name="leave" string="Leaving" domain="[('xn_jl_process', '=', 'leave')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'xn_jl_employee_id'}"/>
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_xn_jl_tasks" model="ir.actions.act_window">
        <field name="name">Steps</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('xn_jl_checklist_id', '!=', False)]</field>
        <field name="context">{'search_default_open': 1, 'create': False}</field>
        <field name="search_view_id" ref="view_task_search_xn_jl"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_task_tree_xn_jl')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('project.view_task_form2')})]"/>
    </record>

    <record id="action_xn_jl_my_tasks" model="ir.actions.act_window">
        <field name="name">My Steps</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('xn_jl_checklist_id', '!=', False)]</field>
        <field name="context">{'search_default_open': 1, 'search_default_mine': 1, 'create': False}</field>
        <field name="search_view_id" ref="view_task_search_xn_jl"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_task_tree_xn_jl')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('project.view_task_form2')})]"/>
    </record>
</odoo>
