<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Users are filled by post_init_hook (ROLE_LOGINS in __init__.py). -->
    <record id="role_hr" model="xn.jl.role">
        <field name="name">HR</field>
        <field name="code">hr</field>
        <field name="sequence">1</field>
    </record>
    <record id="role_hr_head" model="xn.jl.role">
        <field name="name">HR Head</field>
        <field name="code">hr_head</field>
        <field name="sequence">2</field>
    </record>
    <record id="role_ops" model="xn.jl.role">
        <field name="name">Operations Manager (escalations)</field>
        <field name="code">ops</field>
        <field name="sequence">3</field>
    </record>
    <record id="role_it" model="xn.jl.role">
        <field name="name">IT</field>
        <field name="code">it</field>
        <field name="sequence">4</field>
    </record>
    <record id="role_admin" model="xn.jl.role">
        <field name="name">Admin</field>
        <field name="code">admin</field>
        <field name="sequence">5</field>
    </record>
    <record id="role_accounts" model="xn.jl.role">
        <field name="name">Accounts</field>
        <field name="code">accounts</field>
        <field name="sequence">6</field>
    </record>
</odoo>
