<?xml version="1.0"?>
<odoo>
    <data>
        <record id="crm_lead_view_form_inherit_new" model="ir.ui.view">
            <field name="name">Jobs - Recruitment Form</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook/page[@name='application_summary']" position="after">
                    <page name="checklist" string="Recruitment Check List">
                        <group>
                            <group>
                                <!--                                <field name="checklist_ids" widget="many2many_checkboxes"/>-->
                            </group>
                            <group>
                                <div class="oe_title" name="progressbar_template_title">
                                    <field name="progress" widget="percentpie" class="d-block"/>
                                </div>
                            </group>
                        </group>

                        <group>
                            <field name="application_checklist_ids" mode="tree" widget="section_and_note_one2many">
                                <tree editable="bottom">
                                    <field name="checklist_id"/>
                                    <field name="date"/>
                                    <field name="note"/>
                                    <field name="is_done"/>
                                </tree>

                            </field>

                        </group>
                    </page>

                </xpath>


            </field>
        </record>

        <record id="crm_lead_view_tree_inherit_new" model="ir.ui.view">
            <field name="name">Jobs - Recruitment Tree</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.crm_case_tree_view_job"/>
            <field name="arch" type="xml">
                <field name="company_id" position="after">
                    <field name="progress" widget="progressbar"/>
                </field>

            </field>
        </record>

        <record id="inherit_applicant_chekcklist_kanban_view_inherit" model="ir.ui.view">
            <field name="name">hr.applicant.kanban</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
            <field name="arch" type="xml">
<!--                <xpath expr="//div[hasclass('o_kanban_record_bottom mt4')]" position="before">-->
<!--                    <field name="progress" widget="percentpie"/>-->
<!--                </xpath>-->
                <field name="applicant_properties" position="after">
                         <field name="progress" widget="percentpie"/>

                </field>
            </field>
        </record>

    </data>
</odoo>
