<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Applied to the core applicant form, and so also to the Interviewer
        form (a primary view inheriting it). The interviewer form removes the
        whole recruitment_contract group, which is where the CTC fields sit,
        and the salary fields carry groups= as well.
    -->
    <record id="hr_applicant_view_form_xn" model="ir.ui.view">
        <field name="name">hr.applicant.form.xn</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='archive_applicant']" position="before">
                <button string="Give Feedback" name="action_xn_give_feedback" type="object"
                        class="btn-primary" invisible="not active or not id"
                        groups="hr_recruitment.group_hr_recruitment_interviewer"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-comments-o" type="object"
                        name="action_xn_open_feedback" invisible="not xn_feedback_count">
                    <field name="xn_feedback_count" widget="statinfo" string="Feedback"/>
                </button>
            </xpath>

            <!-- Corner ribbons, one at a time; the core Refused/Hired ribbons
                 show on inactive or hired candidates, so these stay off then. -->
            <xpath expr="//div[@name='button_box']" position="before">
                <widget name="web_ribbon" title="On Hold" bg_color="text-bg-warning"
                        invisible="not xn_on_hold or not active or date_closed"/>
                <widget name="web_ribbon" title="Reapplied" bg_color="text-bg-danger"
                        tooltip="Refused less than 6 months ago, see Previously Refused Application"
                        invisible="not xn_reapplied_early or xn_on_hold or not active or date_closed"/>
            </xpath>

            <field name="medium_id" position="after">
                <field name="xn_agency_id" options="{'no_create': True}"/>
                <field name="xn_referrer_id" options="{'no_create': True}"/>
            </field>
            <field name="availability" position="after">
                <field name="xn_notice_days"/>
            </field>

            <xpath expr="//label[@for='salary_expected']" position="before">
                <field name="xn_current_ctc"/>
            </xpath>
            <xpath expr="//group[@name='recruitment_contract']" position="inside">
                <field name="xn_agency_fee" invisible="not xn_agency_fee"/>
            </xpath>

            <field name="applicant_properties" position="before">
                <group name="xn_candidate">
                    <group string="Qualification &amp; Experience">
                        <field name="xn_qualification"/>
                        <field name="xn_papers_passed"/>
                        <field name="xn_ca_final_attempts"/>
                        <field name="xn_articleship_done"/>
                        <field name="xn_total_experience"/>
                        <field name="xn_relevant_experience"/>
                        <field name="xn_location"/>
                    </group>
                    <group string="Status">
                        <field name="xn_round" readonly="1"/>
                        <field name="xn_on_hold"/>
                        <field name="xn_hold_reason" invisible="not xn_on_hold" required="xn_on_hold"/>
                        <field name="xn_reapplied_early" invisible="1"/>
                        <field name="xn_previous_application_id" invisible="not xn_previous_application_id"/>
                    </group>
                </group>
            </field>

            <xpath expr="//notebook" position="inside">
                <page string="Interview Feedback" name="xn_feedback">
                    <field name="xn_feedback_ids" readonly="1" mode="kanban">
                        <kanban class="o_xn_feedback_cards">
                            <field name="date"/>
                            <field name="stage_id"/>
                            <field name="interviewer_id"/>
                            <field name="recommendation"/>
                            <field name="comments"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_card oe_kanban_global_click">
                                        <div class="d-flex align-items-center gap-2">
                                            <field name="interviewer_id" widget="many2one_avatar_user"/>
                                            <div class="flex-grow-1 lh-sm">
                                                <strong><t t-esc="record.interviewer_id.value"/></strong>
                                                <div class="small text-muted">
                                                    <t t-esc="record.stage_id.value"/> - <t t-esc="record.date.value"/>
                                                </div>
                                            </div>
                                            <field name="recommendation" widget="badge"
                                                   decoration-success="recommendation == 'next'"
                                                   decoration-warning="recommendation == 'hold'"
                                                   decoration-danger="recommendation == 'reject'"/>
                                        </div>
                                        <div class="mt-2 text-break" style="white-space: pre-line;">
                                            <t t-esc="record.comments.value"/>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
                <page string="Offer &amp; Joining" name="xn_offer"
                      groups="hr_recruitment.group_hr_recruitment_user">
                    <group>
                        <group string="Offer">
                            <field name="xn_bond_required"/>
                            <field name="xn_bond_months" invisible="not xn_bond_required"/>
                        </group>
                        <group string="Joining">
                            <field name="xn_no_show"/>
                            <field name="xn_no_show_reason" invisible="not xn_no_show"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_case_tree_view_job_xn" model="ir.ui.view">
        <field name="name">hr.applicant.tree.xn</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.crm_case_tree_view_job"/>
        <field name="arch" type="xml">
            <field name="job_id" position="after">
                <field name="xn_on_hold" optional="show" widget="boolean"/>
                <field name="xn_notice_days" optional="hide"/>
                <field name="xn_total_experience" optional="hide"/>
                <field name="xn_qualification" optional="hide"/>
                <field name="xn_agency_id" optional="hide"/>
                <field name="xn_location" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="hr_applicant_view_search_bis_xn" model="ir.ui.view">
        <field name="name">hr.applicant.search.xn</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_search_bis"/>
        <field name="arch" type="xml">
            <field name="job_id" position="after">
                <field name="xn_agency_id"/>
                <field name="xn_referrer_id"/>
            </field>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="xn_on_hold" string="On Hold" domain="[('xn_on_hold', '=', True)]"/>
                <filter name="xn_reapplied_early" string="Reapplied Within 6 Months"
                        domain="[('xn_reapplied_early', '=', True)]"/>
                <filter name="xn_no_show" string="Did Not Join" domain="[('xn_no_show', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_xn_round" string="Hiring Step" context="{'group_by': 'xn_round'}"/>
                    <filter name="group_xn_agency" string="Agency" context="{'group_by': 'xn_agency_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
