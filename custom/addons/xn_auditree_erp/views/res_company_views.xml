<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_xn_auditree" model="ir.ui.view">
        <field name="name">res.company.form.inherit.xn.auditree</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group/group[@name='social_media']" position="after">
                <group>
                    <field name="invoice_signatory_signature" widget="image" class="oe_avatar"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
