<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_leave_type_form_inherit_xn_limit" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.xn.limit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requires_allocation']" position="after">
                <field name="xn_limit_days" invisible="requires_allocation != 'no'"/>
                <field name="xn_limit_period"
                       invisible="requires_allocation != 'no' or xn_limit_days == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
