<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_xn_auditree" model="ir.ui.view">
        <field name="name">account.move.form.inherit.xn.auditree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_signatory_approve" string="Approve"
                        type="object" class="oe_highlight"
                        groups="xn_auditree_erp.group_invoice_signatory"
                        invisible="signatory_approved == True"/>
                <button name="action_signatory_reset" string="Revert Approval"
                        type="object"
                        groups="xn_auditree_erp.group_invoice_signatory"
                        invisible="signatory_approved == False"/>
            </xpath>

            <field name="invoice_date" position="after">
                <field name="invoice_currency_rate"/>
            </field>

            <field name="payment_reference" position="after">
                <field name="signatory_approved" readonly="1"/>
                <field name="signatory_id" readonly="1" invisible="not signatory_approved"/>
                <field name="signatory_approved_date" readonly="1" invisible="not signatory_approved"/>
            </field>

        </field>
    </record>

</odoo>
