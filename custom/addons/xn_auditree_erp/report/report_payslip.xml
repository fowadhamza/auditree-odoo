<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="hakka_employee_payslip_report">
            <t t-call="msr_company_header.company_layout">

                <t t-set="o" t-value="o.with_context(lang=lang).sudo()"/>

                <div class="page" style="letter-spacing: .05rem;position: relative;">

                    <div style="text-align:center;font-family: 'Times New Roman', Times, serif;font-size: 18pt;font-weight: bold;padding-bottom: 12px;">
                        Payslip - <span t-esc="o.date_from.strftime('%B %Y')"/>
                    </div>

                    <table style="width: 100%;font-family: 'Times New Roman', Times, serif;font-size: 11pt;" width="100%">
                        <tr>
                            <td style="padding: 5px;width:20%;font-weight: bold;">Name</td>
                            <td style="padding: 5px;width:30%;">
                                <span t-field="o.employee_id.name"/>
                            </td>
                            <td style="padding: 5px;width:25%;font-weight: bold;">Month</td>
                            <td style="padding: 5px;width:25%;">
                                <span t-esc="o.date_from.strftime('%B %Y')"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 5px;font-weight: bold;">Employee ID</td>
                            <td style="padding: 5px;">
                                <span t-esc="o.get_employee_code()"/>
                            </td>
                            <td style="padding: 5px;font-weight: bold;">Total working days</td>
                            <td style="padding: 5px;">
                                <span t-esc="o.get_total_working_days()"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 5px;font-weight: bold;">Designation</td>
                            <td style="padding: 5px;">
                                <span t-field="o.employee_id.job_id"/>
                            </td>
                            <td style="padding: 5px;font-weight: bold;">No. of Days worked</td>
                            <td style="padding: 5px;">
                                <span t-esc="o.get_days_worked()"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 5px;font-weight: bold;">Bank</td>
                            <td style="padding: 5px;">
                                <span t-field="o.employee_id.bank_account_id.bank_id"/>
                            </td>
                            <td style="padding: 5px;font-weight: bold;">LOP</td>
                            <td style="padding: 5px;">
                                <span t-esc="o._format_payslip_amount(o.get_lop_days())"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 5px;font-weight: bold;">A/C No</td>
                            <td style="padding: 5px;">
                                <span t-field="o.employee_id.bank_account_id.acc_number"/>
                            </td>
                            <td style="padding: 5px;font-weight: bold;">DOJ</td>
                            <td style="padding: 5px;">
                                <span t-field="o.employee_id.joining_date"/>
                            </td>
                        </tr>
                    </table>

                    <div style="height: 28px;"></div>

                    <table style="width: 100%;font-family: 'Times New Roman', Times, serif;border: 1px solid black;font-size: 11pt;">
                        <tr>
                            <td colspan="2" style="width:50%;text-align:center;border:1px solid black;color:#0000FF;">
                                EARNINGS
                            </td>
                            <td colspan="2" style="width:50%;text-align:center;border:1px solid black;color:#0000FF;">
                                DEDUCTIONS
                            </td>
                        </tr>

                        <tr style="text-align:center;border:1px solid black">
                            <td style="width:25%;text-align:left;padding: 5px;border-right:1px solid black;border-left:1px solid black;color:#0000FF;">
                                PARTICULARS
                            </td>
                            <td style="width:25%;text-align:right;padding: 5px;color:#0000FF;">AMOUNT (INR)</td>
                            <td style="border-right:1px solid black;border-left:1px solid black;width:25%;text-align:left;padding: 5px;color:#0000FF;">
                                PARTICULARS
                            </td>
                            <td style="width:25%;text-align:right;padding: 5px;color:#0000FF;">AMOUNT (INR)</td>
                        </tr>

                        <t t-foreach="o.get_report_values()" t-as="d">
                            <tr>
                                <td style="text-align:left;padding: 5px;">
                                    <t t-esc="d['earnings']"/>
                                </td>
                                <td style="text-align:right;padding: 5px;border-right:1px solid black;border-left:1px solid black;">
                                    <t t-esc="d['amount']"/>
                                </td>
                                <td style="text-align:left;padding: 5px;">
                                    <t t-esc="d['deductions']"/>
                                </td>
                                <td style="text-align:right;padding: 5px;border-right:1px solid black;border-left:1px solid black;">
                                    <t t-esc="d['deduction_amount']"/>
                                </td>
                            </tr>
                        </t>

                        <tr style="border-top:1px solid black">
                            <td style="text-align:left;padding: 5px;font-weight: bold;">
                                <span>
                                    <strong>GROSS</strong>
                                </span>
                            </td>
                            <td style="text-align:right;padding: 5px;font-weight: bold;border-right:1px solid black;border-left:1px solid black;">
                                <span t-esc="o._format_payslip_amount(o.get_gross_total())"/>
                            </td>
                            <td style="text-align:left;padding: 5px;font-weight: bold;">
                                <span>
                                    <strong>TOTAL DEDUCTIONS</strong>
                                </span>
                            </td>
                            <td style="text-align:right;padding: 5px;font-weight: bold;border-right:1px solid black;border-left:1px solid black;">
                                <span t-esc="o._format_payslip_amount(o.get_deduction_total())"/>
                            </td>
                        </tr>

                        <tr style="border-top:1px solid black">
                            <td colspan="3" style="text-align:right;padding: 5px;font-weight: bold;">
                                <span>
                                    <strong>NET AMOUNT</strong>
                                </span>
                            </td>
                            <td style="text-align:right;padding: 5px;font-weight: bold;border-right:1px solid black;border-left:1px solid black;">
                                <span t-esc="o._format_payslip_amount(o.get_net_total())"/>
                            </td>
                        </tr>

                        <tr style="border-top:1px solid black">
                            <td style="text-align:left;padding: 5px;font-weight: bold;">
                                <span>
                                    <strong>Amount In Words</strong>
                                </span>
                            </td>
                            <td colspan="3" style="text-align:center;padding: 5px;font-weight: bold;border-left:1px solid black;">
                                <span t-esc="o.amount_to_words(o.get_net_total())"/>
                            </td>
                        </tr>
                    </table>

                    <br/>

                    <div style="text-align:center;font-family: 'Times New Roman', Times, serif;font-size: 11pt;font-weight: bold;">
                        THIS IS COMPUTER GENERATED PAYSLIP NO SIGNATURE IS REQUIRED
                    </div>
                </div>
            </t>
        </template>
        <template id="hakka_report_employee_payslip">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="xn_auditree_erp.hakka_employee_payslip_report"/>
                </t>
            </t>
        </template>


        <template id="auditree_external_layout_payslip">
            <t t-if="not o" t-set="o" t-value="doc"/>

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>

            <t t-call="xn_auditree_erp.auditree_external_layout_custom_payslip">
                <t t-out="0"/>
            </t>

        </template>


        <template id="auditree_external_layout_custom_payslip">
            <div class="header">
                <div class="row">
                    <div class="col-12">
                        <img t-if="company.header_image" t-att-src="image_data_uri(company.header_image)"
                             style="max-height: 65px;" alt="Logo"/>
                    </div>
                </div>
                <div class="row">

                </div>
            </div>

            <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout {{  'o_report_layout_background' if company.layout_background in ['Geometric', 'Custom']  else  '' }}"
                 t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' if company.layout_background == 'Geometric' else ''}});"
                 t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <div class="pt-5">
                    <!-- This div ensures that the address is not cropped by the header. -->
                    <t t-call="web.address_layout"/>
                </div>
                <t t-out="0"/>
            </div>

            <div class="footer">
                <div class="row" style="border:2px solid black;">
                    <div class="col-12">
                        <img t-if="company.footer_image" t-att-src="image_data_uri(company.footer_image)"
                             style="max-height: 65px;" alt="Logo"/>


                        <div t-if="report_type == 'pdf'" class="text-muted">
                            Page:
                            <span class="page"/>
                            /
                            <span class="topage"/>
                        </div>
                    </div>

                </div>
            </div>
        </template>
    </data>
</odoo>
