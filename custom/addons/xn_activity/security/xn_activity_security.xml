<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rules of different groups are OR'ed: an employee matches only the
         "own and team" rules; activity viewers (the board, and HR Officers
         through implied_ids) also match the "all" rules. -->

    <!-- Daily rows and slots: own data, plus everyone below you in the org
         chart (reporting managers: direct and indirect reports); all data
         for viewers. user is a superuser record in rule domains, so
         user.employee_ids reads without HR rights. -->

    <record id="rule_xn_activity_day_own" model="ir.rule">
        <field name="name">Activity day: own and team (reports below in the org chart)</field>
        <field name="model_id" ref="model_xn_activity_day"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_xn_activity_day_hr" model="ir.rule">
        <field name="name">Activity day: viewers (HR, board) see all</field>
        <field name="model_id" ref="model_xn_activity_day"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_xn_activity_viewer')])]"/>
    </record>
    <record id="rule_xn_activity_slot_own" model="ir.rule">
        <field name="name">Activity slot: own and team</field>
        <field name="model_id" ref="model_xn_activity_slot"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_xn_activity_slot_hr" model="ir.rule">
        <field name="name">Activity slot: viewers (HR, board) see all</field>
        <field name="model_id" ref="model_xn_activity_slot"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_xn_activity_viewer')])]"/>
    </record>

    <!-- App usage view (also the 5-minute detail): same as the slots. -->
    <record id="rule_xn_activity_app_usage_own" model="ir.rule">
        <field name="name">Activity app usage: own and team</field>
        <field name="model_id" ref="model_xn_activity_app_usage"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_xn_activity_app_usage_hr" model="ir.rule">
        <field name="name">Activity app usage: viewers (HR, board) see all</field>
        <field name="model_id" ref="model_xn_activity_app_usage"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_xn_activity_viewer')])]"/>
    </record>

    <!-- Day notes: read own (HR: all); create own (HR: anyone's); change or
         delete only notes you wrote yourself. -->
    <record id="rule_xn_activity_note_read_own" model="ir.rule">
        <field name="name">Activity note: read own</field>
        <field name="model_id" ref="model_xn_activity_note"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_xn_activity_note_create_own" model="ir.rule">
        <field name="name">Activity note: add to own days</field>
        <field name="model_id" ref="model_xn_activity_note"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_xn_activity_note_edit_author" model="ir.rule">
        <field name="name">Activity note: author edits</field>
        <field name="model_id" ref="model_xn_activity_note"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_xn_activity_note_hr" model="ir.rule">
        <field name="name">Activity note: HR reads and adds all</field>
        <field name="model_id" ref="model_xn_activity_note"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
