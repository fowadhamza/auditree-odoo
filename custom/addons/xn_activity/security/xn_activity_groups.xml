<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_xn_activity" model="ir.module.category">
        <field name="name">Activity Tracking</field>
        <field name="sequence">60</field>
    </record>

    <!-- Read-only view of everyone's activity reports (Daily Work Metrics,
         App Usage, Devices, Team Timeline, Dashboard) without any HR
         rights. HR Officers get it through implied_ids below. -->
    <record id="group_xn_activity_viewer" model="res.groups">
        <field name="name">View All Employees</field>
        <field name="category_id" ref="module_category_xn_activity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees every employee's activity reports. Cannot
change settings, classify apps or edit employees.</field>
    </record>

    <!-- The board: everything a viewer sees, plus the names in the
         dashboard's "Worth a conversation" panel (people under target).
         No HR group implies it, so HR does not see that panel. -->
    <record id="group_xn_activity_board" model="res.groups">
        <field name="name">Board of Directors</field>
        <field name="category_id" ref="module_category_xn_activity"/>
        <field name="implied_ids" eval="[(4, ref('group_xn_activity_viewer'))]"/>
        <field name="comment">View All Employees, plus the people under target
on the Activity Dashboard.</field>
    </record>

    <!-- IT: download install.ps1 and see the Devices list, nothing else.
         Its own category, so the user form keeps the View All Employees /
         Board of Directors choice as one dropdown. -->
    <record id="module_category_xn_activity_agent" model="ir.module.category">
        <field name="name">Activity Agent</field>
        <field name="sequence">61</field>
    </record>

    <record id="group_xn_activity_installer" model="res.groups">
        <field name="name">Agent Installer</field>
        <field name="category_id" ref="module_category_xn_activity_agent"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Downloads the agent installer and sees the Devices
list (computer, last sign-in, agent version). No activity reports, no
settings, no key changes.</field>
    </record>

    <record id="hr.group_hr_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('xn_activity.group_xn_activity_viewer'))]"/>
    </record>
</odoo>
