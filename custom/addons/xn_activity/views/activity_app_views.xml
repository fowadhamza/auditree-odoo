<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xn_activity_app_tree" model="ir.ui.view">
        <field name="name">xn.activity.app.tree</field>
        <field name="model">xn.activity.app</field>
        <field name="arch" type="xml">
            <tree string="Apps" editable="bottom" create="false"
                  decoration-muted="category == 'unclassified'">
                <field name="name" readonly="1"/>
                <field name="friendly_name"/>
                <field name="category" widget="badge"
                       decoration-success="category == 'productive'"
                       decoration-danger="category == 'unproductive'"
                       decoration-info="category == 'neutral'"/>
                <field name="idle_as_active" optional="show"/>
                <field name="is_system" optional="show"/>
                <field name="create_date" string="First Seen" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_xn_activity_app_form" model="ir.ui.view">
        <field name="name">xn.activity.app.form</field>
        <field name="model">xn.activity.app</field>
        <field name="arch" type="xml">
            <form string="App">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="friendly_name"/>
                        <field name="category"/>
                        <field name="idle_as_active"/>
                        <field name="is_system"/>
                    </group>
                    <separator string="Department Overrides"/>
                    <field name="rule_ids">
                        <tree editable="bottom">
                            <field name="department_id"/>
                            <field name="category"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_xn_activity_app_rule_name" model="ir.ui.view">
        <field name="name">xn.activity.app.rule.tree</field>
        <field name="model">xn.activity.app.rule</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="app_id"/>
                <field name="department_id"/>
                <field name="category"/>
            </tree>
        </field>
    </record>

    <record id="view_xn_activity_app_search" model="ir.ui.view">
        <field name="name">xn.activity.app.search</field>
        <field name="model">xn.activity.app</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="friendly_name"/>
                <filter name="unclassified" string="Unclassified"
                        domain="[('category', '=', 'unclassified')]"/>
                <filter name="has_overrides" string="Has Department Overrides"
                        domain="[('rule_ids', '!=', False)]"/>
                <filter name="is_system" string="Windows / System"
                        domain="[('is_system', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_xn_activity_app" model="ir.actions.act_window">
        <field name="name">App Classification</field>
        <field name="res_model">xn.activity.app</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_xn_activity_app_search"/>
        <field name="help" type="html">
            <p>Programs appear here the first time a laptop reports them, as
               Unclassified. Set each to Productive, Neutral or Unproductive;
               open one to add department overrides.</p>
        </field>
    </record>

    <record id="action_xn_activity_app_rule" model="ir.actions.act_window">
        <field name="name">Department Overrides</field>
        <field name="res_model">xn.activity.app.rule</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
