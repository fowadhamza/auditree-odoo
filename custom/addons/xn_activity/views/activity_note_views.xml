<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xn_activity_note_tree" model="ir.ui.view">
        <field name="name">xn.activity.note.tree</field>
        <field name="model">xn.activity.note</field>
        <field name="arch" type="xml">
            <tree string="Day Notes" editable="top">
                <field name="date"/>
                <field name="employee_id" groups="hr.group_hr_user"
                       options="{'no_create': True}"/>
                <field name="employee_id" groups="!hr.group_hr_user" readonly="1"/>
                <field name="note"/>
                <field name="author_id" readonly="1" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_xn_activity_note_search" model="ir.ui.view">
        <field name="name">xn.activity.note.search</field>
        <field name="model">xn.activity.note</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="note"/>
                <filter name="mine" string="My Days" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="filter_date" date="date"/>
            </search>
        </field>
    </record>

    <record id="action_xn_activity_note" model="ir.actions.act_window">
        <field name="name">Day Notes</field>
        <field name="res_model">xn.activity.note</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_xn_activity_note_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a note to a day</p>
            <p>Explain a day the laptop does not show: a client visit, a stock
               count, offline work. The note appears next to that day in the
               report.</p>
        </field>
    </record>
</odoo>
