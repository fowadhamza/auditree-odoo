<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sits under the existing Leaves app top-level menu -->
    <menuitem id="menu_hr_leave_balance_report"
              name="Leave Balance Report"
              parent="hr_holidays.menu_hr_holidays_management"
              action="action_hr_leave_balance_report"
              sequence="20"
              groups="hr.group_hr_user"/>

    <menuitem id="menu_hr_leave_period_report"
              name="Leave Activity by Period"
              parent="hr_holidays.menu_hr_holidays_management"
              action="action_hr_leave_period_report"
              sequence="21"
              groups="hr.group_hr_user"/>

    <menuitem id="menu_hr_leave_balance_snapshot"
              name="Leave Balance Snapshot"
              parent="hr_holidays.menu_hr_holidays_management"
              action="action_hr_leave_balance_snapshot"
              sequence="22"
              groups="hr.group_hr_user"/>

    <!-- Hide stock Odoo's own "Leave Balance Report" (hr.leave.employee.type.report),
         which sits in the same Management menu under the same name as ours.
         The stock menuitem never sets active, so this survives -u hr_holidays. -->
    <record id="hr_holidays.menu_leave_balance_report" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
