<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ???????????????????????????????????????????????????????????????
         Wide List View  - one row per employee, all leave types as columns
         ??????????????????????????????????????????????????????????????? -->
    <record id="view_hr_leave_balance_report_list" model="ir.ui.view">
        <field name="name">hr.leave.balance.report.list</field>
        <field name="model">hr.leave.balance.report</field>
        <field name="arch" type="xml">
            <tree string="Employee Leave Balances"
                  create="false" edit="false" delete="false"
                  default_order="employee_name">

                <!-- Identity -->
                <field name="employee_name" string="Employee" optional="show"/>
                <field name="department_id" string="Department" optional="show"/>

                <!-- Casual Leave -->
                <field name="casual_allocated" string="CL Alloc"
                       sum="Total" optional="show"/>
                <field name="casual_taken"     string="CL Taken"
                       sum="Total" optional="show"/>
                <field name="casual_balance"   string="CL Balance"
                       sum="Total" optional="show"
                       decoration-danger="casual_balance &lt; 0"
                       decoration-warning="casual_balance == 0"
                       decoration-success="casual_balance &gt; 0"/>

                <!-- Sick Leave -->
                <field name="sick_allocated"   string="SL Alloc"   sum="Total" optional="show"/>
                <field name="sick_taken"       string="SL Taken"   sum="Total" optional="show"/>
                <field name="sick_balance"     string="SL Balance" sum="Total" optional="show"
                       decoration-danger="sick_balance &lt; 0"
                       decoration-warning="sick_balance == 0"
                       decoration-success="sick_balance &gt; 0"/>

                <!-- Earned Leave b/f -->
                <field name="earned_allocated" string="EL Alloc"   sum="Total" optional="show"/>
                <field name="earned_taken"     string="EL Taken"   sum="Total" optional="show"/>
                <field name="earned_balance"   string="EL Balance" sum="Total" optional="show"
                       decoration-danger="earned_balance &lt; 0"
                       decoration-warning="earned_balance == 0"
                       decoration-success="earned_balance &gt; 0"/>

                <!-- Maternity Leave -->
                <field name="maternity_allocated" string="ML Alloc"   sum="Total" optional="show"/>
                <field name="maternity_taken"     string="ML Taken"   sum="Total" optional="show"/>
                <field name="maternity_balance"   string="ML Balance" sum="Total" optional="show"
                       decoration-danger="maternity_balance &lt; 0"
                       decoration-warning="maternity_balance == 0"
                       decoration-success="maternity_balance &gt; 0"/>

                <!-- Comp-off -->
                <field name="compoff_allocated" string="CO Alloc"   sum="Total" optional="show"/>
                <field name="compoff_taken"     string="CO Taken"   sum="Total" optional="show"/>
                <field name="compoff_balance"   string="CO Balance" sum="Total" optional="show"
                       decoration-danger="compoff_balance &lt; 0"
                       decoration-warning="compoff_balance == 0"
                       decoration-success="compoff_balance &gt; 0"/>

                <!-- Grand Totals -->
                <field name="total_allocated" string="Total Alloc"   sum="Grand Total" optional="show"/>
                <field name="total_taken"     string="Total Taken"   sum="Grand Total" optional="show"/>
                <field name="total_balance"   string="Total Balance" sum="Grand Total" optional="show"
                       decoration-danger="total_balance &lt; 0"
                       decoration-success="total_balance &gt; 0"/>

                <!-- Hidden Many2one used for domain/search only -->
                <field name="employee_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ???????????????????????????????????????????????????????????????
         Search View
         ??????????????????????????????????????????????????????????????? -->
    <record id="view_hr_leave_balance_report_search" model="ir.ui.view">
        <field name="name">hr.leave.balance.report.search</field>
        <field name="model">hr.leave.balance.report</field>
        <field name="arch" type="xml">
            <search string="Search Leave Balances">
                <field name="employee_id"   string="Employee"/>
                <field name="department_id" string="Department"/>

                <filter name="negative_balance"
                        string="Has Negative Balance"
                        domain="[('total_balance','&lt;',0)]"/>
                <filter name="zero_balance"
                        string="Fully Used"
                        domain="[('total_balance','=',0)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_department"
                            string="Department"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ???????????????????????????????????????????????????????????????
         Window Action
         ??????????????????????????????????????????????????????????????? -->
    <record id="action_hr_leave_balance_report" model="ir.actions.act_window">
        <field name="name">Employee Leave Balances</field>
        <field name="res_model">hr.leave.balance.report</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No leave balance data found.
            </p>
            <p>Make sure employees have validated leave allocations or approved leave requests.</p>
        </field>
    </record>

</odoo>
