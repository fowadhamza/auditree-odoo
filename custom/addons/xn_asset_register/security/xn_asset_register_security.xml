<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Who can see the asset register.

      Core maintenance leaves its root menu ungated and lists base.group_user
      on every child menu, so installing it puts a Maintenance app in front of
      every internal user. hr_maintenance then quietly promotes every HR
      Officer to Equipment Manager. Neither is wanted here: the register is
      for the handful of people who actually issue and recover hardware.

      This group is deliberately empty on install apart from the
      administrator. Membership is assigned by hand, so it cannot grow as a
      side effect of somebody being given an HR role.
    -->
    <record id="group_asset_register_manager" model="res.groups">
        <field name="name">Asset Register Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids"
               eval="[(4, ref('maintenance.group_equipment_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Can see and manage the company asset register:
            equipment, who holds it, and its condition.</field>
    </record>

    <!--
      Undo hr_maintenance's implied_ids grant. Without this, every HR Officer
      inherits Equipment Manager and therefore the menus below, which defeats
      the point of a hand-assigned group.
    -->
    <record id="hr.group_hr_user" model="res.groups">
        <field name="implied_ids"
               eval="[(3, ref('maintenance.group_equipment_manager'))]"/>
    </record>

    <!--
      Gate every Maintenance menu on the new group.

      (6, 0, [...]) replaces the whole group list rather than adding to it,
      which is what strips base.group_user. Adding would leave every internal
      user seeing the menu, since menu visibility is a union, not an
      intersection.
    -->
    <record id="maintenance.menu_maintenance_title" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.menu_equipment_form" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.menu_m_dashboard" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.menu_m_request" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.menu_m_request_form" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.menu_m_request_calendar" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.menu_m_reports" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.menu_m_reports_oee" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.menu_m_reports_losses" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <!-- Ungated in core: the second Reporting menu carried no groups at all. -->
    <record id="maintenance.maintenance_reporting" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.maintenance_request_reporting" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>
    <record id="maintenance.menu_maintenance_configuration" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('group_asset_register_manager')])]"/>
    </record>

</odoo>
