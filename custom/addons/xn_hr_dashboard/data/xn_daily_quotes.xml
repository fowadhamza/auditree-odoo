    <record id="quote_008" model="xn.daily.quote">
        <field name="sequence">8</field>
        <field name="text">Do the thing and you will have the power.</field>
        <field name="author">Ralph Waldo Emerson</field>
    </record>

    <record id="quote_009" model="xn.daily.quote">
        <field name="sequence">9</field>
        <field name="text">We are what we repeatedly do. Excellence, then, is not an act but a habit.</field>
        <field name="author">Will Durant</field>
    </record>

    <record id="quote_010" model="xn.daily.quote">
        <field name="sequence">10</field>
        <field name="text">Order and simplification are the first steps toward the mastery of a subject.</field>
        <field name="author">Thomas Mann</field>
    </record>

    <record id="quote_011" model="xn.daily.quote">
        <field name="sequence">11</field>
        <field name="text">It always seems impossible until it is done.</field>
        <field name="author">Nelson Mandela</field>
    </record>

    <record id="quote_012" model="xn.daily.quote">
        <field name="sequence">12</field>
        <field name="text">A winner is a dreamer who never gives up.</field>
        <field name="author">Nelson Mandela</field>
