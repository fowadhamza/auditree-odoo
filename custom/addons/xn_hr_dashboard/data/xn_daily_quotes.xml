<?xml version="1.0" encoding="utf-8"?>
<!--
  Seed quotes for the dashboard.

  noupdate="1" is the important attribute here. Without it every
  `-u xn_hr_dashboard` would overwrite whatever HR has edited and revive
  anything they archived. With it, this file seeds a database once and then
  leaves the list alone; it is HR's list from that point on.

  ASCII only - see CLAUDE.md section 3.3. No curly apostrophes, no em
  dashes. Contractions are spelled out ("cannot", "do not") so nothing here
  needs an apostrophe at all.

  On attribution: most of what circulates as a famous quotation is
  misattributed, and a dashboard that credits the wrong person every day is
  worse than one with no quote. Everything below traces to a real source, and
  the popular lines that do not - "Quality is not an act, it is a habit"
  (Will Durant paraphrasing Aristotle, not Aristotle), "Simplicity is the
  ultimate sophistication" (not da Vinci), "Success is not final, failure is
  not fatal" (not Churchill), "The secret of getting ahead is getting
  started" (not Twain) - are deliberately absent. Proverbs are credited as
  proverbs rather than given a borrowed name.
-->
<odoo noupdate="1">

    <record id="quote_001" model="xn.daily.quote">
        <field name="sequence">1</field>
        <field name="text">The best way out is always through.</field>
        <field name="author">Robert Frost</field>
    </record>

    <record id="quote_002" model="xn.daily.quote">
        <field name="sequence">2</field>
        <field name="text">Well done is better than well said.</field>
        <field name="author">Benjamin Franklin</field>
    </record>

    <record id="quote_003" model="xn.daily.quote">
        <field name="sequence">3</field>
        <field name="text">Lost time is never found again.</field>
        <field name="author">Benjamin Franklin</field>
    </record>

    <record id="quote_004" model="xn.daily.quote">
        <field name="sequence">4</field>
        <field name="text">Energy and persistence conquer all things.</field>
        <field name="author">Benjamin Franklin</field>
    </record>

    <record id="quote_005" model="xn.daily.quote">
        <field name="sequence">5</field>
        <field name="text">Nothing in life is to be feared, it is only to be understood.</field>
        <field name="author">Marie Curie</field>
    </record>

    <record id="quote_006" model="xn.daily.quote">
        <field name="sequence">6</field>
        <field name="text">I was taught that the way of progress was neither swift nor easy.</field>
        <field name="author">Marie Curie</field>
    </record>

    <record id="quote_007" model="xn.daily.quote">
        <field name="sequence">7</field>
        <field name="text">The reward of a thing well done is having done it.</field>
        <field name="author">Ralph Waldo Emerson</field>
