<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_config_autoclose_days" model="ir.config_parameter">
            <field name="key">xn_it_helpdesk.autoclose_days</field>
            <field name="value">3</field>
        </record>

        <record id="ir_cron_xn_autoclose_resolved" model="ir.cron">
            <field name="name">IT Helpdesk: auto-close resolved tickets</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model._xn_cron_autoclose_resolved()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
