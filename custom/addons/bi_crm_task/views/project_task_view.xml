<odoo>
    <data>
        <record id="action_view_invoice" model="ir.actions.act_window">
            <field name="name">Invoices</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form,graph</field>
            <field name="domain">[('task_id', '=', active_id)]</field>
            <field name="context">{'search_default_task_id': active_id, 'default_task_id': active_id}</field>
        </record>


        <record id="view_task_form2_inherit1" model="ir.ui.view">
            <field name="name">Task</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button class="oe_stat_button" type="action" name="%(action_view_invoice)d"
                            context="{'default_task_id': active_id }"
                            icon="fa-tasks">
                        <field string="Invoices" name="inv_count" widget="statinfo"/>
                    </button>
                </div>


                <xpath expr="//form/header/field[@name='stage_id']" position="before">
                    <button name="create_invoice" string="Create Invoice" class="btn-primary" type="object"/>
                </xpath>

                <field name="tag_ids" position="after">
                    <field name="billing_type"/>
                    <field name="employee_ids" widget="many2many_tags"/>
                </field>
                <xpath expr="//form/sheet/notebook/page[1]" position="before">
                    <page string="Task Lines">
                        <field name="task_lines" mode="tree">
                            <tree editable="bottom">
                                <field name="employee_id"/>
                                <field name="activity_type"/>
                                <field name="product_id"/>
                                <field name="price_unit"/>
                                <field name="scheduled_date"/>
                                <field name="start"/>
                                <field name="end"/>
                                <field name="tot_hrs"/>
                                <field name="total_amt"/>
                                <field name="status" optional="hide"/>
                                <field name="approval_status" optional="hide"/>
                            </tree>
                        </field>
                        <group>
                            <group class="oe_subtotal_footer" colspan="2" name="sale_total">
                                <field name="bill_amt" invisible="billing_type == 'no_billing' "/>
                                <field name="billed_amt" invisible="billing_type == 'no_billing' "/>
                                <field name="due_amount" invisible="billing_type == 'no_billing' "/>
                            </group>
                        </group>


                    </page>
                </xpath>
            </field>
        </record>


        <record id="view_task_form3_inherit" model="ir.ui.view">
            <field name="name">Task</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <page name="page_timesheets" position="attributes">
                    <attribute name="invisible">1</attribute>
                </page>

            </field>
        </record>


    </data>
</odoo>
        
        