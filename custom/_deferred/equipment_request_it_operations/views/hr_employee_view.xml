<odoo>
    <record model="ir.ui.view" id="employee_form">
        <field name="name">product.template.form (in hr_personal_equipment_request)</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
               <div name="button_box" position="inside">
                    <button class="oe_stat_button" name="action_view_asset_requests"
                            icon="fa-tasks" type="object">
                        <field string="Asset Requests" name="asset_req_count" widget="statinfo"/>
                    </button>
                </div>

            <xpath expr="//form/sheet/notebook/page[3]" position="after">
                <page string="Assets" name="assets">
                    <field name="asset_line_ids"  widget="one2many_tags">
                    <tree create="0">
                        <field name="employee_id" column_invisible="1"/>
                        <field name="product_id"></field>
                        <field name="product_uom_id"/>
                        <field name="quantity"/>
                        <field name="validate_date"/>
                        <field name="hr_date"/>
                        <field name="stock_date"/>
                    </tree>
                </field>
                </page>

            </xpath>
        </field>
    </record>




    <record id="asset_template_action_all" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_is_asset':True}</field>
        <field name="domain">[('is_asset','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product
            </p>
        </field>
    </record>

</odoo>
